# Supabase API Credentials
# Replace these values with your actual Supabase Project API URL and Anonymous Public Key.
# Rename this file to '.env' before running the application.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Razorpay API Credentials
# Replace with your actual Razorpay Key ID from your Razorpay Dashboard Settings -> API Keys (Test or Live).
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Supabase Edge Function Secrets (set with `supabase secrets set`, not exposed to the browser)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
